From b1e0be6412f99b7627e90a133ba3cf2c58e50b64 Mon Sep 17 00:00:00 2001
From: Freimut Diener <f.diener@pengutronix.de>
Date: Wed, 24 Jun 2026 17:55:18 +0200
Subject: [PATCH 29/37] etnaviv/ml: fix Leaky ReLU TP scaling

Let Leaky ReLU use the regular input-to-output scale in the TP config and
build the LUT in the expected value domain. This avoids applying the
input scale twice.
---
 src/gallium/drivers/etnaviv/etnaviv_ml_tp.c | 13 ++++++-------
 1 file changed, 6 insertions(+), 7 deletions(-)

diff --git a/src/gallium/drivers/etnaviv/etnaviv_ml_tp.c b/src/gallium/drivers/etnaviv/etnaviv_ml_tp.c
index 51fd9b51439..4f9bf1fcd6c 100644
--- a/src/gallium/drivers/etnaviv/etnaviv_ml_tp.c
+++ b/src/gallium/drivers/etnaviv/etnaviv_ml_tp.c
@@ -806,8 +806,7 @@ create_pwl_lut_config(struct etna_ml_subgraph *subgraph, const struct etna_opera
    uint32_t scale;
 
    if (operation->tp_type == ETNA_ML_TP_LOGISTIC ||
-       operation->tp_type == ETNA_ML_TP_RELU6 ||
-       operation->tp_type == ETNA_ML_TP_LEAKY_RELU)
+       operation->tp_type == ETNA_ML_TP_RELU6)
       scale = fui(1.0 / operation->output_scale);
    else
       scale = fui(operation->input_scale / operation->output_scale);
@@ -1354,25 +1353,25 @@ create_leaky_relu_lut(struct etna_ml_subgraph *subgraph,
    uint32_t *map = calloc(lut_table_len, sizeof(uint32_t));
    unsigned pos = 0;
 
-   /* Positive half: identity (same real-value encoding as relu6) */
+   /* Positive half: identity (same real-value encoding as relu) */
    for (int i = 0; i < 16; i++)
       map[pos++] = fp21(0.0f);
 
    for (int cur_val = 0x8000; cur_val < 0xf8000; cur_val += 0x800)
-      map[pos++] = fp21(fp32(cur_val) * operation->input_scale);
+      map[pos++] = fp21(fp32(cur_val));
 
    for (int i = 0; i < 16; i++)
-      map[pos++] = fp21(fp32(0xf7fff) * operation->input_scale);
+      map[pos++] = fp21(fp32(0xf7fff));
 
    /* Negative half: alpha * input (output is negative for alpha < 1, input < 0) */
    for (int i = 0; i < 16; i++)
       map[pos++] = fp21(0.0f);
 
    for (int cur_val = 0x8000; cur_val < 0xf8000; cur_val += 0x800)
-      map[pos++] = fp21(-operation->leaky_relu_alpha * fp32(cur_val) * operation->input_scale);
+      map[pos++] = fp21(-operation->leaky_relu_alpha * fp32(cur_val));
 
    for (int i = 0; i < 16; i++)
-      map[pos++] = fp21(-operation->leaky_relu_alpha * fp32(0xf7fff) * operation->input_scale);
+      map[pos++] = fp21(-operation->leaky_relu_alpha * fp32(0xf7fff));
 
    return map;
 }

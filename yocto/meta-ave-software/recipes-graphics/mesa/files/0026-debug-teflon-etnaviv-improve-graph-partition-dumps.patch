+static const char *
+pipe_ml_type_name(enum pipe_ml_operation_type type, bool depthwise)
+{
+   switch (type) {
+   case PIPE_ML_OPERATION_TYPE_ADD:             return "ADD";
+   case PIPE_ML_OPERATION_TYPE_CONVOLUTION:     return depthwise ? "DWCONV" : "CONV";
+   case PIPE_ML_OPERATION_TYPE_CONCATENATION:   return "CONCAT";
+   case PIPE_ML_OPERATION_TYPE_POOLING:         return "POOL";
+   case PIPE_ML_OPERATION_TYPE_SPLIT:           return "SPLIT";
+   case PIPE_ML_OPERATION_TYPE_PAD:             return "PAD";
+   case PIPE_ML_OPERATION_TYPE_FULLY_CONNECTED: return "FCON";
+   case PIPE_ML_OPERATION_TYPE_RESHAPE:         return "RESHAPE";
+   case PIPE_ML_OPERATION_TYPE_RELU:            return "RELU";
+   case PIPE_ML_OPERATION_TYPE_ABSOLUTE:        return "ABS";
+   case PIPE_ML_OPERATION_TYPE_LOGISTIC:        return "LOG";
+   case PIPE_ML_OPERATION_TYPE_TANH:            return "TANH";
+   case PIPE_ML_OPERATION_TYPE_HSWISH:          return "HSWISH";
+   case PIPE_ML_OPERATION_TYPE_RELU6:           return "RELU6";
+   case PIPE_ML_OPERATION_TYPE_SUBTRACT:        return "SUB";
+   case PIPE_ML_OPERATION_TYPE_TRANSPOSE:       return "TRANSPOSE";
+   case PIPE_ML_OPERATION_TYPE_STRIDED_SLICE:   return "STRIDED_SLICE";
+   case PIPE_ML_OPERATION_TYPE_RESIZE:          return "RESIZE";
+   case PIPE_ML_OPERATION_TYPE_MAXIMUM:         return "MAX";
+   case PIPE_ML_OPERATION_TYPE_MINIMUM:         return "MIN";
+   case PIPE_ML_OPERATION_TYPE_MUL:             return "MUL";
+   case PIPE_ML_OPERATION_TYPE_QUANTIZE:        return "QUANT";
+   case PIPE_ML_OPERATION_TYPE_LEAKY_RELU:      return "LEAKY_RELU";
+   }
+   return "???";
+}

+      format_tensor_list(in, sizeof(in), operation->input_tensors, operation->input_count);
+      format_tensor_list(out, sizeof(out), operation->output_tensors, operation->output_count);
+      snprintf(io, sizeof(io), "%s -> %s", in, out);
+
+      if (operation->input_width || operation->output_width)
+         snprintf(shape, sizeof(shape), "%ux%ux%u -> %ux%ux%u",
+                  operation->input_width, operation->input_height, operation->input_channels,
+                  operation->output_width, operation->output_height, operation->output_channels);
+      else
+         snprintf(shape, sizeof(shape), "-");

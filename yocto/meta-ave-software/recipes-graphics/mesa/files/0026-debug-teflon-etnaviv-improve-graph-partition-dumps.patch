+      switch (operation->type) {
+      case ETNA_JOB_TYPE_NN: {
+         const char *kind = operation->fully_connected ? "fc" :
+                            operation->depthwise ? "dwconv" :
+                            operation->pointwise ? "pwconv" : "conv";

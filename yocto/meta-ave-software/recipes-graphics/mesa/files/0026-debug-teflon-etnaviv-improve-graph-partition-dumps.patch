+      }
+      case ETNA_JOB_TYPE_TP:
+         snprintf(details, sizeof(details), "%s", etna_tp_type_name(operation->tp_type));
          break;
-      case ETNA_JOB_TYPE_BYPASS:
-         ML_DBG("%3d %-4s %3d %3d",
-                i, "BYPASS", operation->input_tensors[0], operation->output_tensors[0]);
+      default:
          break;
       }
-      ML_DBG("\n");
+
+      ML_DBG("%3u %-6s %-13s %-22s %s\n", i, etna_job_type_name(operation->type), io, shape, details);
       i++;
    }
    ML_DBG("\n");

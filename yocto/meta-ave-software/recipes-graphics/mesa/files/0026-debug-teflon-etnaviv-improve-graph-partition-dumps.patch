From c02a10bb9e3e37d82d1021f837442cefc2083294 Mon Sep 17 00:00:00 2001
From: Freimut Diener <f.diener@pengutronix.de>
Date: Thu, 11 Jun 2026 14:13:39 +0200
Subject: [PATCH 26/37] debug: teflon/etnaviv: improve graph partition dumps

Make TEFLON_DEBUG and ETNA_MESA_DEBUG=ml dumps show delegated partitions,
activation inputs and outputs, operation tensor flow, quantization data,
and lowered etnaviv job details. This gives a concise overview of how a
model is split and lowered.
---
 src/gallium/drivers/etnaviv/etnaviv_ml.c  | 100 ++++++++---
 src/gallium/frontends/teflon/tfl_device.c | 209 +++++++++-------------
 2 files changed, 163 insertions(+), 146 deletions(-)

diff --git a/src/gallium/drivers/etnaviv/etnaviv_ml.c b/src/gallium/drivers/etnaviv/etnaviv_ml.c
index e149d10329b..8ccec601f46 100644
--- a/src/gallium/drivers/etnaviv/etnaviv_ml.c
+++ b/src/gallium/drivers/etnaviv/etnaviv_ml.c
@@ -175,40 +175,94 @@ recreate_tensor(struct etna_ml_subgraph *subgraph, unsigned idx, unsigned size)
    etna_ml_create_tensor(subgraph, idx, size);
 }
 
+static const char *
+etna_job_type_name(enum etna_job_type type)
+{
+   switch (type) {
+   case ETNA_JOB_TYPE_NN:     return "NN";
+   case ETNA_JOB_TYPE_TP:     return "TP";
+   case ETNA_JOB_TYPE_CONCAT: return "CONCAT";
+   case ETNA_JOB_TYPE_SPLIT:  return "SPLIT";
+   case ETNA_JOB_TYPE_BYPASS: return "BYPASS";
+   }
+   return "???";
+}
+
+static const char *
+etna_tp_type_name(enum etna_ml_tp_type type)
+{
+   switch (type) {
+   case ETNA_ML_TP_TRANSPOSE:   return "transpose";
+   case ETNA_ML_TP_DETRANSPOSE: return "detranspose";
+   case ETNA_ML_TP_RESHUFFLE:   return "reshuffle";
+   case ETNA_ML_TP_PAD:         return "pad";
+   case ETNA_ML_TP_RELU:        return "relu";
+   case ETNA_ML_TP_ABSOLUTE:    return "abs";
+   case ETNA_ML_TP_LOGISTIC:    return "logistic";
+   case ETNA_ML_TP_RELU6:       return "relu6";
+   }
+   return "???";
+}
+
+static void
+format_tensor_list(char *buf, size_t size, const unsigned *tensors, unsigned count)
+{
+   size_t off = 0;
+   for (unsigned i = 0; i < count && off < size; i++)
+      off += snprintf(buf + off, size - off, "%s%u", i ? "," : "", tensors[i]);
+}

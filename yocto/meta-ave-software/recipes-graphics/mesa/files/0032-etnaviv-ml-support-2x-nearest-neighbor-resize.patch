diff --git a/src/gallium/drivers/etnaviv/etnaviv_ml_tp.c b/src/gallium/drivers/etnaviv/etnaviv_ml_tp.c
index 4f9bf1fcd6c..0c6a34984dd 100644
--- a/src/gallium/drivers/etnaviv/etnaviv_ml_tp.c
+++ b/src/gallium/drivers/etnaviv/etnaviv_ml_tp.c
@@ -1127,6 +1127,103 @@ etna_ml_lower_leaky_relu(struct etna_ml_subgraph *subgraph,
    operation->leaky_relu_alpha = leaky_relu->leakyrelu.alpha;
 }
 
+void
+etna_ml_lower_resize(struct etna_ml_subgraph *subgraph,
+                     const struct pipe_ml_operation *resize,
+                     struct etna_operation *operation)
+{
+   assert(resize->type == PIPE_ML_OPERATION_TYPE_RESIZE);
+
+   operation->type = ETNA_JOB_TYPE_TP;
+   operation->tp_type = ETNA_ML_TP_RESIZE;
+
+   operation->input_count = 1;
+   operation->input_width = resize->input_tensors[0]->dims[1];
+   operation->input_height = resize->input_tensors[0]->dims[2];
+   operation->input_channels = resize->input_tensors[0]->dims[3];
+   operation->input_tensor_sizes[0] = operation->input_width *
+                                      operation->input_height *
+                                      operation->input_channels;
+   operation->input_zero_point = etna_tensor_zero_point(resize->input_tensors[0]);
+   operation->input_scale = resize->input_tensors[0]->scale;
+
+   operation->output_count = 1;
+   operation->output_width = resize->output_tensors[0]->dims[1];
+   operation->output_height = resize->output_tensors[0]->dims[2];
+   operation->output_channels = resize->output_tensors[0]->dims[3];
+   operation->output_zero_point = etna_tensor_zero_point(resize->output_tensors[0]);
+   operation->output_scale = resize->output_tensors[0]->scale;
+   operation->output_tensor_sizes[0] = operation->output_width *
+                                       operation->output_height *
+                                       operation->output_channels;
+}
+
+static void *
+create_resize_config(struct etna_ml_subgraph *subgraph,
+                     const struct etna_operation *operation)
+{
+   struct etna_tp_params *map = calloc(1, sizeof(struct etna_tp_params));
+   unsigned input_width = operation->input_width;
+   unsigned input_height = operation->input_height;
+   unsigned input_channels = operation->input_channels;
+   unsigned output_width = operation->output_width;
+   unsigned output_height = operation->output_height;
+   /* dx/dy select the 2x2 output sub-lattice this pass writes. */
+   unsigned dx = operation->resize_phase & 0x1;
+   unsigned dy = (operation->resize_phase >> 1) & 0x1;
+
+   set_default_tp_config(map);
+
+   SWAP(input_width, input_height);
+   SWAP(output_width, output_height);
+
+   map->in_image_x_size = input_width;
+   map->in_image_y_size = input_height;
+   map->in_image_z_size = input_channels;
+   map->in_image_stride = input_width;
+   map->in_image_slice = input_width * input_height;
+
+   map->in_window_x_start = 0x0;
+   map->in_window_y_start = 0x0;
+   map->in_window_x_end = input_width - 1;
+   map->in_window_y_end = input_height - 1;
+   map->in_tile_x_size = input_width;
+   map->in_tile_x_inc = input_width;
+   map->in_tile_y_size = input_height;
+   map->in_tile_y_inc = input_height;
+
+   unsigned offset = etna_ml_get_offset(subgraph, operation->input_tensors[0]);
+   map->in_image_base_address = offset;
+
+   offset = etna_ml_get_offset(subgraph, operation->output_tensors[0]);
+   map->out_image_base_address = offset + dy * output_width + dx;
+
+   /* One output element is written per input element, in a single nested
+    * scatter that mirrors the proven transpose path (loops 0/1/2, no resets):
+    *   loop 0 walks the input row    -> output x stride 2
+    *   loop 1 walks the input column -> output y stride 2 (2 * output_width)
+    *   loop 2 walks the channels     -> output plane stride
+    * The input scan (x, then y, then z) pairs with these loops, so each input
+    * pixel lands at its 2x2 block origin shifted by this phase's (dy, dx). The
+    * four phases together fill the whole output (2x nearest-neighbour).
+    */
+   map->out_loop_0_inc = 0x2;
+   map->out_loop_1_inc = output_width * 2;
+   map->out_loop_2_inc = output_width * output_height;
+   map->out_loop_0_count = input_width;
+   map->out_loop_1_count = input_height;
+   map->out_loop_2_count = input_channels;
+
+   map->in_zp = operation->input_zero_point;
+   map->out_zp = operation->output_zero_point;
+   map->in_image_circular_buf_size = 0x0;
+   map->in_image_circular_buf_end_address_plus_1 = 0xFFFFFFFF >> 6;
+   map->out_image_circular_buf_size = 0x0;
+   map->out_image_circular_buf_end_address_plus_1 = 0xFFFFFFFF >> 6;
+
+   return map;
+}
+
 static void *
 create_relu_lut(struct etna_ml_subgraph *subgraph,
                const struct etna_operation *operation,
@@ -1502,6 +1599,11 @@ etna_ml_compile_operation_tp(struct etna_ml_subgraph *subgraph,
       num_configs = tp_cores_used;
       break;
    }
+   case ETNA_ML_TP_RESIZE:
+      instruction->config_data[0] = create_resize_config(subgraph, operation);
+      instruction->config_sizes[0] = sizeof(struct etna_tp_params);
+      num_configs = 1;
+      break;
    }
    instruction->type = ETNA_JOB_TYPE_TP;
    instruction->tp_type = operation->tp_type;

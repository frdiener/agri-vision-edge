 }
@@ -334,7 +335,8 @@ lower_operations(struct etna_ml_subgraph *subgraph,
 
          if (poperation->type == PIPE_ML_OPERATION_TYPE_CONVOLUTION ||
              poperation->type == PIPE_ML_OPERATION_TYPE_FULLY_CONNECTED ||
-             poperation->type == PIPE_ML_OPERATION_TYPE_CONCATENATION)
+             poperation->type == PIPE_ML_OPERATION_TYPE_CONCATENATION ||
+             poperation->type == PIPE_ML_OPERATION_TYPE_RESIZE)
             operation_layout = ETNA_ML_LAYOUT_NCHW;
 
          if (!etna_ml_find_producer(poperations, count, poperation->input_tensors[i]->index)) {
@@ -458,6 +460,23 @@ lower_operations(struct etna_ml_subgraph *subgraph,
             list_addtail(&operation->link, etna_operations);
             break;
          }
+         case PIPE_ML_OPERATION_TYPE_RESIZE: {
+            /* A single TP job scatters exactly one output element per input
+             * element. Emit the 2x nearest-neighbour resize as four scatter
+             * passes, one per output position in the 2x2 replicated block.
+             */
+            for (unsigned phase = 0; phase < 4; phase++) {
+               struct etna_operation *resize = phase == 0 ? operation
+                                                          : calloc(1, sizeof(*resize));
+
+               etna_ml_lower_resize(subgraph, poperation, resize);
+               resize->resize_phase = phase;
+               resize->input_tensors[0] = input_tensors[0];
+               resize->output_tensors[0] = poperation->output_tensors[0]->index;
+               list_addtail(&resize->link, etna_operations);
+            }
+            break;
+         }
       case PIPE_ML_OPERATION_TYPE_RESHAPE: {
          struct etna_ml_tensor *tensor = etna_ml_get_tensor(subgraph, input_tensors[0]);
          if (
@@ -674,6 +693,7 @@ count_tensors(const struct pipe_ml_operation *poperations,
       case PIPE_ML_OPERATION_TYPE_RELU6:
       case PIPE_ML_OPERATION_TYPE_LEAKY_RELU:
       case PIPE_ML_OPERATION_TYPE_TRANSPOSE:

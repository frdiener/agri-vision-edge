 src/gallium/drivers/etnaviv/etnaviv_ml.h    |   7 ++
 src/gallium/drivers/etnaviv/etnaviv_ml_tp.c | 102 ++++++++++++++++++++
 src/gallium/drivers/etnaviv/etnaviv_ml_tp.h |   7 +-
 4 files changed, 158 insertions(+), 3 deletions(-)


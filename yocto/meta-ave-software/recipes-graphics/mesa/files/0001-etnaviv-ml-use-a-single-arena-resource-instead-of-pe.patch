@@ -1077,10 +1045,11 @@ etna_ml_subgraph_destroy(struct pipe_ml_device *pdevice, struct pipe_ml_subgraph
    util_dynarray_foreach(&subgraph->tensors, struct etna_ml_tensor*, tensor) {

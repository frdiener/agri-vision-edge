 src/gallium/drivers/etnaviv/etnaviv_ml.c    | 79 +++++++--------------
 src/gallium/drivers/etnaviv/etnaviv_ml.h    |  5 +-
 src/gallium/drivers/etnaviv/etnaviv_ml_nn.c |  8 +--
 src/gallium/drivers/etnaviv/etnaviv_ml_tp.c | 24 +++----
 4 files changed, 43 insertions(+), 73 deletions(-)


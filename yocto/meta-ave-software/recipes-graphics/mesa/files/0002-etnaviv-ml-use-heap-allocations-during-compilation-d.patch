+static void
+etna_ml_apply_relocations(struct etna_ml_subgraph *subgraph,
+                          struct etna_vip_instruction *instr)
+{
+   struct etna_bo *io_bo = etna_buffer_resource(subgraph->io_rsrc)->bo;
+
+   util_dynarray_foreach(&instr->relocations, struct etna_ml_relocation, reloc) {
+      uint32_t *config_words = (uint32_t *)instr->config_data[reloc->config_idx];
+      uint32_t new_addr;
+
+      switch (reloc->type) {
+      case ETNA_ML_RELOC_INPUT:
+      case ETNA_ML_RELOC_OUTPUT:
+         new_addr = etna_bo_gpu_va(io_bo) + reloc->addend;
+         break;
+      case ETNA_ML_RELOC_COEFFICIENTS:
+         new_addr = etna_bo_gpu_va(instr->coefficients) + reloc->addend;
+         break;
+      case ETNA_ML_RELOC_PWL_LUT:
+         new_addr = etna_bo_gpu_va(instr->pwl_lut) + reloc->addend;
+         break;
+      default:
+         UNREACHABLE("Unknown relocation type");
+         return;
+      }
+
+      new_addr >>= reloc->shift;
+
+      if (reloc->mask_bits == 32)
+         config_words[reloc->word_offset] = new_addr;
+      else {
+         uint32_t mask = (1u << reloc->mask_bits) - 1;
+         config_words[reloc->word_offset] =
+            (config_words[reloc->word_offset] & ~mask) | (new_addr & mask);
+      }
+   }
+}
+
+static void
+prepare_submission(struct etna_ml_subgraph *subgraph)
+{
+   struct pipe_screen *pscreen = &subgraph->screen->base;
+
+   /* Create the IO arena resource */
+   subgraph->io_rsrc = pipe_buffer_create(pscreen, 0, PIPE_USAGE_DEFAULT, subgraph->io_used);
+   void *ptr = etna_bo_map(etna_buffer_resource(subgraph->io_rsrc)->bo);
+   memset(ptr, 0, pipe_buffer_size(subgraph->io_rsrc));
+
+   /* Upload per-instruction data to BOs and apply relocations */
+   util_dynarray_foreach(&subgraph->operations, struct etna_vip_instruction, instr) {
+      /* Upload coefficients to BO */
+      if (instr->coefficients_data) {
+         instr->coefficients = etna_ml_create_bo(subgraph->screen, instr->coefficients_size);
+         etna_bo_cpu_prep(instr->coefficients, DRM_ETNA_PREP_WRITE);
+         memcpy(etna_bo_map(instr->coefficients), instr->coefficients_data, instr->coefficients_size);
+         etna_bo_cpu_fini(instr->coefficients);
+      }
+
+      /* Upload PWL LUT to BO */
+      if (instr->pwl_lut_data) {
+         instr->pwl_lut = etna_ml_create_bo(subgraph->screen, instr->pwl_lut_size);
+         etna_bo_cpu_prep(instr->pwl_lut, DRM_ETNA_PREP_WRITE);
+         memcpy(etna_bo_map(instr->pwl_lut), instr->pwl_lut_data, instr->pwl_lut_size);
+         etna_bo_cpu_fini(instr->pwl_lut);
+      }
+
+      /* Apply relocations: patch config data with actual GPU addresses */
+      etna_ml_apply_relocations(subgraph, instr);
+
+      /* Upload config data to BOs */
+      for (unsigned j = 0; j < MAX_CONFIG_BOS && instr->config_data[j]; j++) {
+         instr->configs[j] = etna_ml_create_bo(subgraph->screen, instr->config_sizes[j]);
+         etna_bo_cpu_prep(instr->configs[j], DRM_ETNA_PREP_WRITE);
+         memcpy(etna_bo_map(instr->configs[j]), instr->config_data[j], instr->config_sizes[j]);
+         etna_bo_cpu_fini(instr->configs[j]);
+      }
+
+      /* Free heap copies */
+      for (unsigned j = 0; j < MAX_CONFIG_BOS; j++)
+         free(instr->config_data[j]);
+      free(instr->coefficients_data);
+      free(instr->pwl_lut_data);
+      instr->coefficients_data = NULL;
+      instr->pwl_lut_data = NULL;
+      memset(instr->config_data, 0, sizeof(instr->config_data));
+   }
+}

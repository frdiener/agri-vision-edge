diff --git a/src/gallium/drivers/rocket/rkt_ml.h b/src/gallium/drivers/rocket/rkt_ml.h
index 7775989d3d5..d02b5b71812 100644
--- a/src/gallium/drivers/rocket/rkt_ml.h
+++ b/src/gallium/drivers/rocket/rkt_ml.h
@@ -128,7 +128,8 @@ rkt_ml_operation_supported(struct pipe_ml_device *pdevice, const struct pipe_ml_
 struct pipe_ml_subgraph *
 rkt_ml_subgraph_create(struct pipe_ml_device *pdevice,
                        const struct pipe_ml_operation *poperations,
-                       unsigned count);
+                       unsigned count,
+                       unsigned outputs_count, unsigned output_idxs[]);
 
 void rkt_ml_subgraph_invoke(struct pipe_context *pcontext,
                             struct pipe_ml_subgraph *psubgraph,
diff --git a/src/gallium/frontends/teflon/tfl_device.c b/src/gallium/frontends/teflon/tfl_device.c
index 197954d1c78..93c7bdd7b4b 100644
--- a/src/gallium/frontends/teflon/tfl_device.c
+++ b/src/gallium/frontends/teflon/tfl_device.c
@@ -644,7 +644,9 @@ partition_init(TfLiteContext *tf_context, const char *buffer, size_t length)
    struct pipe_ml_subgraph *subgraph;
    subgraph = delegate->ml_dev->ml_subgraph_create(delegate->ml_dev,
                                                    operations,
-                                                   params->nodes_to_replace->size);
+                                                   params->nodes_to_replace->size,
+                                                   params->output_tensors->size,
+                                                   params->output_tensors->data);
 
    struct teflon_subgraph *tsubgraph = calloc(1, sizeof(*tsubgraph));
    tsubgraph->base = subgraph;
diff --git a/src/gallium/include/pipe/p_state.h b/src/gallium/include/pipe/p_state.h
index 0ae00006597..eb78062dcfd 100644
--- a/src/gallium/include/pipe/p_state.h
+++ b/src/gallium/include/pipe/p_state.h
@@ -1318,11 +1318,14 @@ struct pipe_ml_device {
     * \param device      pipe_ml_device to be used
     * \param operations  array containing the definitions of the operations in the graph
     * \param count       number of operations
+    * \param outputs_count number of output tensors
+    * \param output_idxs output tensor indices
     * \return            a newly allocated pipe_ml_subgraph
     */
    struct pipe_ml_subgraph *(*ml_subgraph_create)(struct pipe_ml_device *device,
                                                   const struct pipe_ml_operation *operations,
-                                                  unsigned count);
+                                                  unsigned count,
+                                                  unsigned ouptuts_count, unsigned output_idxs[]);
 
    /**
     * Serialize a compiled subgraph into a byte buffer.

# Originally generated by systemd-cryptsetup-generator and afterwards manually
# adjusted to be based upon ptx-cryptsetup instead of systemd-cryptsetup

[Unit]
Description=Cryptography Setup for %I partition

DefaultDependencies=no
After=cryptsetup-pre.target systemd-udevd-kernel.socket
Before=blockdev@dev-mapper-%i.target
Wants=blockdev@dev-mapper-%i.target
IgnoreOnIsolate=true
Conflicts=umount.target
Before=umount.target
Before=cryptsetup.target
BindsTo=dev-disk-by\x2dpartlabel-%i.device
After=dev-disk-by\x2dpartlabel-%i.device

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutSec=infinity
KeyringMode=shared
OOMScoreAdjust=500
ExecStart=/usr/sbin/ptx-cryptsetup attach %i /dev/disk/by-partlabel/%i
ExecStop=/usr/sbin/ptx-cryptsetup detach %i

[Install]
RequiredBy=dev-mapper-%i.device cryptsetup.target
